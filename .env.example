# Copy to .env.local and fill in real values. NEVER commit real values.
# NEVER use a NEXT_PUBLIC_* variable for a secret — NEXT_PUBLIC_* values
# are inlined into the client bundle and visible to anyone.
#
# The MongoDB URI, Gemini API key and Clerk webhook secret below were
# previously exposed via NEXT_PUBLIC_* variables. If this repo was ever
# deployed with those names, ROTATE all three (Atlas / AI Studio /
# Clerk Dashboard) and set only the server-only names below.

# MongoDB Atlas connection string (server-only)
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Google Gemini API key (server-only)
GEMINI_API_KEY=your-gemini-api-key-here

# Clerk webhook signing secret (server-only, from Clerk Dashboard > Webhooks)
WEBHOOK_SECRET=your-clerk-webhook-secret-here

# Clerk (publishable key is public by design; secret key is server-only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key-here
CLERK_SECRET_KEY=your-clerk-secret-key-here

# TinyMCE API key (public client key by design — it is not a secret,
# but keep the exact variable name used in the code)
NEXT_PUBLIC_tINY_EDITOR_API_KEY=your-tinymce-api-key-here

# AI features kill switch (server-only). Set to "false" to disable all
# /api/ai/* endpoints (they return 503). Defaults to enabled when unset.
AI_ENABLED=true
